# Qwen Cloud (Token Plan)
QWEN_CLOUD_API_KEY=sk-sp-your-key-here
QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# DataForSEO
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Bing Webmaster Tools
BING_WEBMASTER_TOOLS_API_KEY=your-key

# Google PageSpeed (optional, for Core Web Vitals)
PAGESPEED_API_KEY=

# Mock mode (for development without API keys)
MOCK_LLM=false
MOCK_DFS=false
