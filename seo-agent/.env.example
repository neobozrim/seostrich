# DataForSEO credentials
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# Bing Webmaster Tools
BING_WEBMASTER_TOOLS_API_KEY=your_api_key

# Google Search Console
# Service account JSON credentials (paste the entire JSON content)
GOOGLE_SEARCH_CONSOLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Alibaba Cloud Qwen API
QWEN_API_KEY=your_qwen_api_key

# Memory system path (optional, defaults to relative path)
# MEMORY_DIR=/path/to/agent-memory
