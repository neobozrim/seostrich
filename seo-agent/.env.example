# DataForSEO credentials
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# Bing Webmaster Tools
BING_WEBMASTER_TOOLS_API_KEY=your_api_key

# Google Search Console
# Service account JSON credentials file path
GSC_CREDENTIALS_PATH=gsc-console-creds.json

# Braintrust (optional - for conversation tracing and self-improvement)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=your_braintrust_project_uuid

# Alibaba Cloud Qwen API
# LLM_PROVIDER picks the endpoint: "cloud" (default, does not queue) or
# "token_plan" (queues burst traffic — needs LLM_MIN_INTERVAL_SECONDS pacing).
LLM_PROVIDER=cloud
QWEN_CLOUD_API_KEY=your_qwen_api_key
# QWEN_TOKEN_PLAN_API_KEY=your_token_plan_key
# QWEN_BASE_URL=            # explicit override; unset = provider default
# QWEN_MODEL=qwen3.6-plus
# LLM_MIN_INTERVAL_SECONDS=20   # only needed on token_plan

# Post-run reflection tail (memory synthesis + self-learning): ~10 extra LLM
# calls per run carrying the full session JSON. Off by default.
# AGENT_REFLECTION=off

# Google Search Console — alternative: paste service account JSON directly
# GSC_CREDENTIALS_JSON={"type": "service_account", ...}

# Shared-account auth (enabled only when BOTH are set)
# APP_USERNAME=judges
# APP_PASSWORD=***
# AUTH_SECRET=long-random-string

# Deployment (hosted environments)
# MEMORY_DIR=/data/agent-memory
# SESSIONS_DIR=/data/sessions
# CACHE_DIR=/data/cache
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# PORT=8001
